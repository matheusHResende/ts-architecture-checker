{
  "name": "archscript",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start:dev": "nodemon",
    "start": "npm run build && node build/index.js",
    "test": "jest",
    "build": "tsc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.ts$": ["ts-jest", {
        "tsconfig": {
          "strict": true,
          "esModuleInterop": true,
          "module": "commonjs",
          "target": "es2021"
        }
      }]
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^17.0.45",
    "@types/yargs": "^17.0.8",
    "jest": "^29.7.0",
    "nodemon": "^2.0.15",
    "rimraf": "^3.0.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.5.0",
    "typescript": "^4.5.5"
  },
  "dependencies": {
    "@diagrams-ts/graphviz-cli-renderer": "^0.5.0",
    "dom-to-image": "^2.6.0",
    "ts-graphviz": "^0.16.0",
    "yargs": "^17.3.1"
  }
}
